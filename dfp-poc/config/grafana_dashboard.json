{
  "dashboard": {
    "title": "NVIDIA Morpheus DFP - Pipeline Monitoring",
    "tags": ["dfp", "morpheus", "anomaly-detection"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 0,
    "refresh": "30s",

    "panels": [
      {
        "id": 1,
        "title": "Pipeline Health",
        "type": "stat",
        "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
        "targets": [
          {
            "expr": "rate(dfp_errors_total[5m])",
            "legendFormat": "Error Rate",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "background",
          "graphMode": "area",
          "justifyMode": "auto",
          "orientation": "horizontal",
          "reduceOptions": {
            "values": false,
            "fields": "",
            "calcs": ["lastNotNull"]
          }
        },
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "value": null, "color": "green" },
                { "value": 1, "color": "yellow" },
                { "value": 5, "color": "red" }
              ]
            }
          }
        }
      },

      {
        "id": 2,
        "title": "Events Processed",
        "type": "stat",
        "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
        "targets": [
          {
            "expr": "sum(rate(dfp_events_processed_total[5m]))",
            "legendFormat": "Events/sec",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "orientation": "horizontal",
          "reduceOptions": {
            "values": false,
            "fields": "",
            "calcs": ["lastNotNull"]
          }
        }
      },

      {
        "id": 3,
        "title": "Detection Rate",
        "type": "gauge",
        "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
        "targets": [
          {
            "expr": "dfp_detection_rate",
            "legendFormat": "{{ pipeline }}",
            "refId": "A"
          }
        ],
        "options": {
          "showThresholdLabels": false,
          "showThresholdMarkers": true
        },
        "fieldConfig": {
          "defaults": {
            "min": 0,
            "max": 1,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "value": null, "color": "green" },
                { "value": 0.3, "color": "yellow" },
                { "value": 0.6, "color": "red" }
              ]
            },
            "unit": "percentunit"
          }
        }
      },

      {
        "id": 4,
        "title": "Active Models",
        "type": "stat",
        "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
        "targets": [
          {
            "expr": "dfp_active_models",
            "legendFormat": "{{ pipeline }}",
            "refId": "A"
          }
        ]
      },

      {
        "id": 5,
        "title": "Throughput (Events/sec)",
        "type": "graph",
        "gridPos": { "x": 0, "y": 4, "w": 12, "h": 6 },
        "targets": [
          {
            "expr": "rate(dfp_events_processed_total[1m])",
            "legendFormat": "{{ pipeline }}",
            "refId": "A"
          }
        ],
        "yaxes": [
          { "format": "short", "label": "Events/sec" },
          { "format": "short" }
        ],
        "lines": true,
        "fill": 1,
        "linewidth": 2
      },

      {
        "id": 6,
        "title": "Anomalies Detected",
        "type": "graph",
        "gridPos": { "x": 12, "y": 4, "w": 12, "h": 6 },
        "targets": [
          {
            "expr": "rate(dfp_anomalies_detected_total[5m])",
            "legendFormat": "{{ pipeline }}",
            "refId": "A"
          }
        ],
        "yaxes": [
          { "format": "short", "label": "Anomalies/sec" },
          { "format": "short" }
        ],
        "lines": true,
        "fill": 1,
        "linewidth": 2
      },

      {
        "id": 7,
        "title": "Operation Latency (P95)",
        "type": "graph",
        "gridPos": { "x": 0, "y": 10, "w": 12, "h": 6 },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(dfp_operation_latency_seconds_bucket[5m]))",
            "legendFormat": "{{ operation }}",
            "refId": "A"
          }
        ],
        "yaxes": [
          { "format": "s", "label": "Latency (seconds)" },
          { "format": "short" }
        ],
        "lines": true,
        "fill": 0,
        "linewidth": 2
      },

      {
        "id": 8,
        "title": "Model Performance (Z-Score Distribution)",
        "type": "heatmap",
        "gridPos": { "x": 12, "y": 10, "w": 12, "h": 6 },
        "targets": [
          {
            "expr": "rate(dfp_z_score_bucket[5m])",
            "legendFormat": "{{ le }}",
            "format": "heatmap",
            "refId": "A"
          }
        ]
      },

      {
        "id": 9,
        "title": "System Resources - CPU",
        "type": "graph",
        "gridPos": { "x": 0, "y": 16, "w": 8, "h": 5 },
        "targets": [
          {
            "expr": "system_cpu_percent",
            "legendFormat": "CPU Usage",
            "refId": "A"
          }
        ],
        "yaxes": [
          { "format": "percent", "label": "CPU %", "max": 100 },
          { "format": "short" }
        ],
        "alert": {
          "conditions": [
            {
              "evaluator": { "type": "gt", "params": [90] },
              "operator": { "type": "and" },
              "query": { "params": ["A", "5m", "now"] },
              "reducer": { "type": "avg" },
              "type": "query"
            }
          ],
          "frequency": "60s",
          "handler": 1,
          "name": "High CPU Usage",
          "noDataState": "no_data",
          "message": "CPU usage is above 90%"
        }
      },

      {
        "id": 10,
        "title": "System Resources - Memory",
        "type": "graph",
        "gridPos": { "x": 8, "y": 16, "w": 8, "h": 5 },
        "targets": [
          {
            "expr": "system_memory_percent",
            "legendFormat": "Memory Usage",
            "refId": "A"
          }
        ],
        "yaxes": [
          { "format": "percent", "label": "Memory %", "max": 100 },
          { "format": "short" }
        ]
      },

      {
        "id": 11,
        "title": "System Resources - Disk",
        "type": "graph",
        "gridPos": { "x": 16, "y": 16, "w": 8, "h": 5 },
        "targets": [
          {
            "expr": "system_disk_percent",
            "legendFormat": "Disk Usage",
            "refId": "A"
          }
        ],
        "yaxes": [
          { "format": "percent", "label": "Disk %", "max": 100 },
          { "format": "short" }
        ]
      },

      {
        "id": 12,
        "title": "Model Training Activity",
        "type": "graph",
        "gridPos": { "x": 0, "y": 21, "w": 12, "h": 5 },
        "targets": [
          {
            "expr": "rate(dfp_models_trained_total[5m])",
            "legendFormat": "Models Trained/sec",
            "refId": "A"
          }
        ],
        "yaxes": [
          { "format": "short", "label": "Models/sec" },
          { "format": "short" }
        ],
        "bars": true,
        "lines": false
      },

      {
        "id": 13,
        "title": "Reconstruction Error (Mean)",
        "type": "graph",
        "gridPos": { "x": 12, "y": 21, "w": 12, "h": 5 },
        "targets": [
          {
            "expr": "avg(dfp_reconstruction_error) by (model)",
            "legendFormat": "{{ model }}",
            "refId": "A"
          }
        ],
        "yaxes": [
          { "format": "short", "label": "Error" },
          { "format": "short" }
        ],
        "lines": true,
        "fill": 1
      },

      {
        "id": 14,
        "title": "Pipeline Errors (by type)",
        "type": "table",
        "gridPos": { "x": 0, "y": 26, "w": 12, "h": 6 },
        "targets": [
          {
            "expr": "topk(10, sort_desc(sum by (pipeline, error_type) (rate(dfp_errors_total[5m]))))",
            "format": "table",
            "instant": true,
            "refId": "A"
          }
        ]
      },

      {
        "id": 15,
        "title": "Top Users by Anomaly Count",
        "type": "table",
        "gridPos": { "x": 12, "y": 26, "w": 12, "h": 6 },
        "targets": [
          {
            "expr": "topk(10, sort_desc(sum by (user_id) (dfp_anomalies_detected_total)))",
            "format": "table",
            "instant": true,
            "refId": "A"
          }
        ]
      }
    ],

    "templating": {
      "list": [
        {
          "name": "pipeline",
          "type": "query",
          "query": "label_values(dfp_events_processed_total, pipeline)",
          "label": "Pipeline",
          "allValue": ".*",
          "multi": true,
          "includeAll": true
        },
        {
          "name": "interval",
          "type": "interval",
          "query": "5m,10m,30m,1h,6h,12h,1d",
          "label": "Interval",
          "auto": true
        }
      ]
    },

    "time": {
      "from": "now-6h",
      "to": "now"
    },

    "timepicker": {
      "refresh_intervals": [
        "5s",
        "10s",
        "30s",
        "1m",
        "5m",
        "15m",
        "30m",
        "1h",
        "2h",
        "1d"
      ]
    }
  }
}
