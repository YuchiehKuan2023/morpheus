# LLM provider: 'github' | 'groq' | 'ollama'
LLM_PROVIDER=github
LLM_API_KEY=<your_github_or_groq_api_key>
LLM_ROUTER_MODEL=gpt-4o-mini
LLM_MAIN_MODEL=Llama-3.3-70B-Instruct
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=3800

# Conversational AI mode: 'pipeline' (legacy 3-pass) or 'agentic' (ReAct loop)
CHAT_MODE=agentic

# MLflow Configuration
MLFLOW_TRACKING_URI=http://localhost:5001
MLFLOW_EXPERIMENT_NAME=dfp/demo-pipeline

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_DETECTIONS_TOPIC=dfp-detections
KAFKA_EVENTS_TOPIC=dfp-events
KAFKA_CONSUMER_GROUP=dfp-frontend

# Cache Directory
CACHE_DIR=../.cache/demo/rolling-user-data

# Application environment (development, staging, production)
ENVIRONMENT=development

# CORS allowed origins (comma-separated list)
# Development: http://localhost:5173
# Production: https://your-domain.com,https://app.your-domain.com
CORS_ORIGINS=http://localhost:5173

# Database Configuration (TimescaleDB on Docker, port 5433)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# API Configuration
HOST=0.0.0.0
PORT=8001
LOG_LEVEL=INFO
