# ========================================
# Anomaly Generation Rules
# ========================================
anomaly_distribution:
  # What percentage of users should have anomalies in generated dataset?
  # Realistic: Not everyone is compromised - only 30-40%
  percentage_users_with_anomalies: 0.35 # 35% = ~18 of 50 users

  # Distribution of anomaly types
  anomaly_types:
    impossible_travel:
      probability: 0.25 # 25% of anomalies
      description: "Access from geographically distant location in impossible timeframe"
      severity: "high"
      applies_to: "all" # Can happen to any user

    off_hours_access:
      probability: 0.20 # 20% of anomalies
      description: "Access outside trained work hours (per user baseline)"
      severity: "medium"
      applies_to: ["users without late-night work pattern"]
      # NOTE: Will NOT generate for users with work_hours.end >= 20

    unusual_application:
      probability: 0.15 # 15% of anomalies
      description: "Access to application never seen during training"
      severity: "medium"
      applies_to: "all"

    excessive_activity:
      probability: 0.20 # 20% of anomalies
      description: "Activity count > 2x user's typical maximum"
      severity: "medium"
      applies_to: "all"

    privilege_escalation:
      probability: 0.10 # 10% of anomalies
      description: "Non-privileged user accessing admin resources"
      severity: "critical"
      applies_to: ["users without privileged_access"]
      # NOTE: Will NOT generate for users with privileged_access: true

    unusual_device:
      probability: 0.10 # 10% of anomalies (benign)
      description: "Access from browser/OS never seen in training"
      severity: "low"
      applies_to: "all"
      malicious: false # This is often benign (new laptop, etc.)

