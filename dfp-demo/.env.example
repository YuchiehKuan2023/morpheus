# DFP Demo Environment Configuration
# Copy from .env.example and customize for your environment

# ============================================================================
# AI Services - LLM Configuration
# ============================================================================

# LLM provider: 'github' | 'groq' | 'ollama'
LLM_PROVIDER=github

# API key for the selected provider
# github → GitHub PAT with Models:read or copilot scope
# groq   → Groq API key
# ollama → leave blank
LLM_API_KEY=

# LLM models (applied across conversational AI and DFP pipeline)
LLM_ROUTER_MODEL=gpt-4o-mini                          # Conversational AI router: intent classification (low-tier)
LLM_MAIN_MODEL=Llama-3.3-70B-Instruct                 # Conversational AI answers (high-tier)
LLM_ORCHESTRATOR_MODEL=Meta-Llama-3.1-405B-Instruct   # AI Orchestrator: enrichment + Stage 1 validation (high-tier)
LLM_ORCHESTRATOR_FALLBACK=gpt-4o                      # Fallback when 405B-Instruct hits daily limit (high-tier)
LLM_AGENT_MODEL=Phi-4                                 # Agent Orchestrator: forensics/investigation/remediation (low-tier)

# Generation parameters
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=3800

# ============================================================================
# Database Configuration
# ============================================================================

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=dfp_ai
POSTGRES_USER=dfp_ai
POSTGRES_PASSWORD=

# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Qdrant Configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# ============================================================================
# Application Configuration
# ============================================================================

# Application Environment
ENVIRONMENT=development

# API Server Configuration
HOST=0.0.0.0
PORT=8001
LOG_LEVEL=info

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================================================
# MLflow Configuration
# ============================================================================

MLFLOW_TRACKING_URI=http://localhost:5001
MLFLOW_EXPERIMENT_NAME=dfp-demo

# ============================================================================
# Kafka Configuration
# ============================================================================

KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:29092
KAFKA_INPUT_TOPIC=dfp-events
KAFKA_OUTPUT_TOPIC=dfp-detections
KAFKA_CONTROL_TOPIC=control-messages

# ============================================================================
# Security & Secrets
# ============================================================================

# Secret key for JWT tokens (generate with: openssl rand -hex 32)
SECRET_KEY=your-secret-key-here-generate-a-strong-one

# ============================================================================
# Feature Flags
# ============================================================================

# Enable AI Intelligence Layer
ENABLE_AI_ENRICHMENT=true
ENABLE_LLM_EXPLANATIONS=true
ENABLE_ENTITY_EXTRACTION=true
ENABLE_VECTOR_SEARCH=true
ENABLE_GRAPH_CONTEXT=true

# Enable Advanced Features
ENABLE_AUTO_LABELING=false
ENABLE_ROOT_CAUSE=false
ENABLE_FORECASTING=false
ENABLE_MULTI_AGENT=false

# Conversational AI mode: 'pipeline' (legacy 3-pass) or 'agentic' (ReAct loop)
CHAT_MODE=agentic

# ============================================================================
# Development & Testing
# ============================================================================

# Debug mode
DEBUG=true
TESTING=false

# Disable in production
ENABLE_PROFILING=false
ENABLE_METRICS_EXPORT=true
